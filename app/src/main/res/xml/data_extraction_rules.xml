<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- See backup_rules.xml: the Briefcase's token and mirror stay on this phone. -->
        <exclude domain="sharedpref" path="briefcase.xml" />
        <exclude domain="file" path="briefcase/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="briefcase.xml" />
        <exclude domain="file" path="briefcase/" />
    </device-transfer>
</data-extraction-rules>
