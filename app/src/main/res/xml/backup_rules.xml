<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        My Briefcase's own preferences hold the bearer token that reaches somebody's files on
        their computer, and a mirror that only means anything on the phone it was built on.
        Neither belongs in a backup: a restored phone connects again, which is a code and two
        taps, and the token it left behind cannot follow it anywhere.
    -->
    <exclude domain="sharedpref" path="briefcase.xml" />
    <exclude domain="file" path="briefcase/" />
</full-backup-content>
