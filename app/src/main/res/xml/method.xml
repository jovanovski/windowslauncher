<?xml version="1.0" encoding="utf-8"?>
<!--
  What the system needs to know about the keyboard.

  One subtype per language. A subtype is how a single input method offers more than one
  language: it is what the phone's own language switcher lists, and what the globe key on
  the keyboard cycles through, so a layout that is not declared here can be selected inside
  the keyboard but is invisible to everything outside it.

  `supportsSwitchingToNextInputMethod` is what lets the globe in the navigation bar move on
  from this keyboard rather than dead-ending on it. `languageTag` is the modern spelling of
  `imeSubtypeLocale`; both are given because the old one is what older code reads and the new
  one is what `InputMethodSubtype.getLanguageTag()` returns - declare only the old and that
  method hands back an empty string.

  Every language the keyboard ships a layout for has one, whether or not the user has turned
  it on - a subtype that is not declared cannot be enabled later, and the settings list is
  what narrows this down to the handful somebody actually reads.

  English is marked ASCII-capable, which is not decoration. Android will refuse to hand a
  password field to an input method that cannot promise plain Latin letters, and a keyboard
  that only declared Macedonian would be silently replaced on every login screen on the
  phone.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="rocks.gorjan.gokixp.wp81.keyboard.KeyboardSettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="English"
        android:imeSubtypeLocale="en_US"
        android:languageTag="en-US"
        android:imeSubtypeMode="keyboard" android:isAsciiCapable="true" />
    <subtype
        android:label="Deutsch"
        android:imeSubtypeLocale="de"
        android:languageTag="de"
        android:imeSubtypeMode="keyboard" />
