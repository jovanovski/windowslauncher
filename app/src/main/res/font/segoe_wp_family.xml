<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Phone 8.1 typography.

  WP8.1 leans on the thin weights far more than the desktop themes do: the large
  page headers ("Applications", pivot titles) are Light/Semilight, while tile and
  list labels sit at Regular. Kept separate from segoeui_font_family.xml so the
  Vista theme's existing 400/800 pairing is untouched.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="300"
        android:font="@font/segoeui_light" />

    <font
        android:fontStyle="normal"
        android:fontWeight="350"
        android:font="@font/segoeui_semilight" />

    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/segoeui_regular" />

    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/segoeui_semibold" />

    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/segoeui_bold" />
</font-family>
