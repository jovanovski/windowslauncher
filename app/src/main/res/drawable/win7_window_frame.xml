<?xml version="1.0" encoding="utf-8"?>
<!-- A Windows 7 window: one pane of glass from the title bar down the sides, inside a 1dp dark outline and a 1dp highlight, measured off a genuine active Aero window. Drawn on window_frame so the title bar and the border are the same surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:topLeftRadius="7dp" android:topRightRadius="7dp" />
            <stroke android:width="1dp" android:color="#D2081018" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:topLeftRadius="6dp" android:topRightRadius="6dp" />
            <stroke android:width="1dp" android:color="#CCF0F6FA" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <corners android:topLeftRadius="5dp" android:topRightRadius="5dp" />
            <solid android:color="#CC5386B2" />
        </shape>
    </item>
</layer-list>
