<?xml version="1.0" encoding="utf-8"?>
<!-- An unfocused Windows 7 window: the same frame, the glass more see-through. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:topLeftRadius="7dp" android:topRightRadius="7dp" />
            <stroke android:width="1dp" android:color="#99081018" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:topLeftRadius="6dp" android:topRightRadius="6dp" />
            <stroke android:width="1dp" android:color="#99F0F6FA" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <corners android:topLeftRadius="5dp" android:topRightRadius="5dp" />
            <solid android:color="#9E5882A9" />
        </shape>
    </item>
</layer-list>
