<?xml version="1.0" encoding="utf-8"?>
<!-- The notification area's overflow flyout: a small pane of the same glass as a window frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="5dp" />
            <solid android:color="#CC5386B2" />
            <stroke android:width="1dp" android:color="#D2081018" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#CCF0F6FA" />
        </shape>
    </item>
</layer-list>
