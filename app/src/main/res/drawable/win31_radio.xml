<?xml version="1.0" encoding="utf-8"?>
<!-- Windows 3.1's own radio glyphs, out of USER's OBM_CHECKBOXES bitmap: thicker while held. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_checked="true" android:drawable="@drawable/win31_radio_on_pressed" />
    <item android:state_pressed="true" android:drawable="@drawable/win31_radio_off_pressed" />
    <item android:state_checked="true" android:drawable="@drawable/win31_radio_on" />
    <item android:drawable="@drawable/win31_radio_off" />
</selector>
