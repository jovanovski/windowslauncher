<?xml version="1.0" encoding="utf-8"?>
<!-- Up: light on the top and left, shadow on the bottom and right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The outline, drawn as four bars so the corner pixels stay out of it -->
    <item android:left="1dp" android:right="1dp" android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#000000" /></shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#000000" /></shape>
    </item>
    <item android:top="1dp" android:bottom="1dp" android:gravity="left" android:width="1dp">
        <shape android:shape="rectangle"><solid android:color="#000000" /></shape>
    </item>
    <item android:top="1dp" android:bottom="1dp" android:gravity="right" android:width="1dp">
        <shape android:shape="rectangle"><solid android:color="#000000" /></shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle"><solid android:color="#808080" /></shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF" /></shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="#C0C0C0" /></shape>
    </item>
</layer-list>
