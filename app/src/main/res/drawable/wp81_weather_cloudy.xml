<?xml version="1.0" encoding="utf-8"?>
<!--
  wp81_weather_cloudy - broken cloud.

  The sun in the corner the cloud has left it, and only the rays that corner can
  hold: one colour cannot show a disc through a cloud, so the two are set apart
  rather than overlapped.
  Drawn on the same 76x76 grid and at the same 3-4 unit weight as the rest of the WP8.1
  glyph set, and emitted white so the tile tints it to its accent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="76"
    android:viewportHeight="76">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16,24 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <group android:pivotX="24" android:pivotY="24" android:rotation="0">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M21,5 L27,5 L27,13 L21,13 Z" />
    </group>
    <group android:pivotX="24" android:pivotY="24" android:rotation="45">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M21,5 L27,5 L27,13 L21,13 Z" />
    </group>
    <group android:pivotX="24" android:pivotY="24" android:rotation="90">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M21,5 L27,5 L27,13 L21,13 Z" />
    </group>
    <group android:pivotX="24" android:pivotY="24" android:rotation="270">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M21,5 L27,5 L27,13 L21,13 Z" />
    </group>
    <group android:pivotX="24" android:pivotY="24" android:rotation="315">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M21,5 L27,5 L27,13 L21,13 Z" />
    </group>
    <!-- The cloud, kept low and right so the sun stands clear of it. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,42 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M28,50 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52,50 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,50 L60,50 L60,58 L36,58 Z" />
</vector>
