<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy blue pill behind the time and mine counters -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <gradient android:angle="270" android:startColor="#4C78C4" android:endColor="#1D4596" />
            <stroke android:width="1dp" android:color="#1A3268" />
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="1dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
