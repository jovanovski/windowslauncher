<?xml version="1.0" encoding="utf-8"?>
<!-- Active caption: dark blue, the colour a VGA screen gave the default scheme's ActiveTitle. A black line closes the caption off from what is below it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><solid android:color="#000000" /></shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle"><solid android:color="#000080" /></shape>
    </item>
</layer-list>
