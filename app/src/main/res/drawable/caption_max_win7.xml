<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Activated = the window has focus (WindowsDialog.setFocused sets it on the title bar). -->
    <item android:state_pressed="true" android:drawable="@drawable/caption_max_win7_pressed" />
    <item android:state_hovered="true" android:drawable="@drawable/caption_max_win7_hot" />
    <item android:state_activated="true" android:drawable="@drawable/caption_max_win7_normal" />
    <item android:drawable="@drawable/caption_max_win7_inactive" />
</selector>
