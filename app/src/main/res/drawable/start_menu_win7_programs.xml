<?xml version="1.0" encoding="utf-8"?>
<!-- The white programs pane: a dark 1dp edge with a faint highlight outside it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1dp" android:color="#FF35414B" />
        </shape>
    </item>
</layer-list>
