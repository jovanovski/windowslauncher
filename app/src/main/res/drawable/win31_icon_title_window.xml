<?xml version="1.0" encoding="utf-8"?>
<!-- The title under an icon inside a Windows 3.1 window (a program group, or the Program
     Manager's workspace): on the window's white, and on the highlight while selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/win31_icon_title_selected" />
    <item android:state_selected="true" android:drawable="@drawable/win31_icon_title_selected" />
    <item android:drawable="@android:color/transparent" />
</selector>
