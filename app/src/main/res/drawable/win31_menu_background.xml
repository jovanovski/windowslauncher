<?xml version="1.0" encoding="utf-8"?>
<!-- A Windows 3.1 drop-down menu: white, a black line round it, and a dark shadow on the
     right and bottom that the menu casts on whatever is under it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#808080" /></shape>
    </item>
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#000000" />
        </shape>
    </item>
</layer-list>
