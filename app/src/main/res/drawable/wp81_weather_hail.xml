<?xml version="1.0" encoding="utf-8"?>
<!--
  wp81_weather_hail - hail.

  What falls in hail is round and hard, and drawing it as rain would leave this icon
  and the rain telling the same story.
  Drawn on the same 76x76 grid and at the same 3-4 unit weight as the rest of the WP8.1
  glyph set, and emitted white so the tile tints it to its accent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="76"
    android:viewportHeight="76">
    <!-- The cloud, lifted to leave the lower third of the grid to what is
         falling. The same cloud carries every icon in the set. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M27,30 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18,38 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M46,38 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M26,38 L54,38 L54,46 L26,46 Z" />
    <!-- Pellets rather than drops. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,62 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,68 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,62 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
</vector>
