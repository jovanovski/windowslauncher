<?xml version="1.0" encoding="utf-8"?>
<!-- A Windows 3.1 drop-down list: a white box in a black line, and on its right the raised
     button carrying USER's own combo glyph (OBM_COMBO), sharing the box's line. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#000000" />
        </shape>
    </item>
    <item android:gravity="end|fill_vertical" android:width="17dp">
        <shape android:shape="rectangle"><solid android:color="#000000" /></shape>
    </item>
    <item android:gravity="end|fill_vertical" android:width="15dp" android:top="1dp" android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle"><solid android:color="#808080" /></shape>
    </item>
    <item android:gravity="end|fill_vertical" android:width="13dp" android:top="1dp" android:bottom="3dp" android:right="3dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF" /></shape>
    </item>
    <item android:gravity="end|fill_vertical" android:width="12dp" android:top="2dp" android:bottom="3dp" android:right="3dp">
        <shape android:shape="rectangle"><solid android:color="#C0C0C0" /></shape>
    </item>
    <item android:gravity="end|center_vertical" android:right="5dp" android:width="7dp" android:height="9dp"
        android:drawable="@drawable/win31_combo_glyph" />
</layer-list>
