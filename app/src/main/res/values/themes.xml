<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Windows XP Theme (Default / Base) -->
    <style name="Base.Theme.GokiXP" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disable automatic tinting by setting neutral colors -->
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryVariant">@android:color/transparent</item>
        <item name="colorSecondary">@android:color/transparent</item>
        <item name="colorSecondaryVariant">@android:color/transparent</item>
        <item name="colorAccent">@android:color/transparent</item>
        <item name="colorControlNormal">@android:color/black</item>
        <item name="colorControlActivated">@android:color/black</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="colorButtonNormal">@android:color/transparent</item>
        <!-- Remove tinting from controls -->
        <item name="android:colorControlNormal">@android:color/black</item>
        <item name="android:colorControlActivated">@android:color/black</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <!-- Windows XP specific attributes -->
        <item name="primaryFontFamily">@font/tahoma_font_family</item>
        <item name="secondaryFontFamily">@font/tahoma_font_family</item>
        <item name="scrollbarTrackDrawable">@drawable/scrollbar_track_xp</item>
        <item name="scrollbarThumbDrawable">@drawable/scrollbar_thumb_xp</item>
        <item name="winButtonStyle">@style/WinXPButton</item>
        <item name="windowBackgroundColor">#ebe9da</item>
        <item name="dialogBackgroundColor">#ebe9da</item>
        <item name="menuBarBackground">@drawable/menu_bar</item>
        <item name="solitareGreen">@color/solitare_green</item>
        <item name="notificationBubble">@drawable/bubble</item>
        <item name="notificationBubbleTitleColor">#000000</item>


    </style>

    <!-- Windows Vista Theme -->
    <style name="Theme.GokiXP.Vista" parent="Base.Theme.GokiXP">
        <item name="primaryFontFamily">@font/segoeui_font_family</item>
        <item name="secondaryFontFamily">@font/segoeui_font_family</item>
        <item name="scrollbarTrackDrawable">@drawable/scrollbar_track_vista</item>
        <item name="scrollbarThumbDrawable">@drawable/scrollbar_thumb_vista</item>
        <item name="winButtonStyle">@style/WinVistaButton</item>
        <item name="windowBackgroundColor">#cad9e7</item>
        <item name="dialogBackgroundColor">#FFFFFF</item>
        <item name="menuBarBackground">@drawable/menu_bar_vista</item>
        <item name="solitareGreen">@drawable/solitare_green</item>
        <item name="notificationBubble">@drawable/bubble_vista</item>
        <item name="notificationBubbleTitleColor">#4C54C7</item>


    </style>

    <!-- Windows 7 Theme: Vista's Aero attributes, which Windows 7 kept -->
    <style name="Theme.GokiXP.Win7" parent="Theme.GokiXP.Vista">
        <item name="winButtonStyle">@style/Win7Button</item>
    </style>

    <style name="Win7Button" parent="WinVistaButton">
        <item name="android:background">@drawable/button_win7</item>
    </style>

    <!-- A link in the Windows 7 start menu's right-hand column -->
    <style name="Win7StartPlace">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:background">@drawable/start_places_item_win7</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/segoeui_regular</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="Win7StartPlaceSeparator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/start_menu_win7_places_separator</item>
    </style>

    <!-- Windows Classic Theme -->
    <style name="Theme.GokiXP.Classic" parent="Base.Theme.GokiXP">
        <item name="primaryFontFamily">@font/micross_font_family</item>
        <item name="windowBackgroundColor">#d4cec6</item>
        <item name="dialogBackgroundColor">#d4cec6</item>
        <item name="secondaryFontFamily">@font/micross_font_family</item>
        <item name="scrollbarTrackDrawable">@drawable/scrollbar_track_98</item>
        <item name="scrollbarThumbDrawable">@drawable/win98_start_menu_border</item>
        <item name="winButtonStyle">@style/Win98Button</item>
    </style>


    <!-- Windows 3.1 Theme: the "Windows Default" colour scheme - grey desktop, white windows -->
    <style name="Theme.GokiXP.Win31" parent="Theme.GokiXP.Classic">
        <item name="windowBackgroundColor">#FFFFFF</item>
        <item name="dialogBackgroundColor">#FFFFFF</item>
        <item name="winButtonStyle">@style/Win31Button</item>
    </style>

    <!-- Windows 3.1 Program Manager pieces -->
    <style name="Win31MenuBarItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:background">@drawable/win31_menu_bar_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/w31_system</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/win31_icon_title_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Win31GroupIcon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Win31GroupIconImage">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:src">@drawable/win31_group</item>
    </style>

    <style name="Win31GroupIconTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:background">@drawable/win31_icon_title_window</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:fontFamily">@font/micross_block</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@color/win31_icon_title_text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Button Widget Styles -->
    <style name="Win98Button" parent="@android:style/Widget.Button">
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">@font/micross_block</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:background">@drawable/win98_start_menu_border</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- A drive on the Windows 3.1 File Manager's drive bar: WinFile's bitmap and the letter -->
    <style name="Win31DriveBarDrive">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/win31_fm_drive_selected</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">3dp</item>
    </style>

    <style name="Win31DriveBarDriveImage">
        <item name="android:layout_width">23dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:scaleType">fitXY</item>
    </style>

    <style name="Win31DriveBarDriveLetter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:fontFamily">@font/micross_block</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Win31Button" parent="@android:style/Widget.Button">
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">@font/w31_system</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/win31_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- The About Windows box the Windows 3.1 welcome screen is drawn as -->
    <style name="Win31AboutText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/w31_system</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Win31AboutButton">
        <item name="android:layout_width">66dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:background">@drawable/win31_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/w31_system</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="WinXPButton" parent="@android:style/Widget.Button">
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">@font/tahoma_font_family</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">@drawable/vista_button</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="WinVistaButton" parent="@android:style/Widget.Button">
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">@font/segoeui_font_family</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">@drawable/vista_button</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="MenuBarItem" parent="@android:style/Widget.TextView">
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">?primaryFontFamily</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>


    <style name="MenuBarItemDisabled" parent="MenuBarItem">
        <item name="android:textColor">#666666</item>
    </style>

    <!-- Light AlertDialog Theme -->
    <style name="LightAlertDialog" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="android:textColor">#000000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="colorAccent">#0078D7</item>
        <item name="android:buttonBarButtonStyle">@style/LightDialogButton</item>
    </style>

    <style name="LightDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#0078D7</item>
    </style>
</resources>