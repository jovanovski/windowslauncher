<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        What is left here is the part of the Display Properties sheet that is still built in
        XML: three styles the wallpaper picker sets on its check boxes and section headings.
        Everything else a program draws - buttons, fields, lists, menus, separators - now
        comes out of the winui kit at runtime, which is why this file no longer carries a
        Windows98.Button beside a WindowsXP.Button. A control that knows which shell it is
        cannot follow one.
    -->
    <style name="Win95.CheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="buttonTint">@null</item>
        <item name="android:button">@drawable/checkbox_windows</item>
    </style>

    <!-- Header for a group of settings in the Display Properties dialog -->
    <style name="Win95.SectionHeader" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">@font/micross_block</item>
        <item name="android:textSize">11dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <!-- Etched horizontal rule under a section header -->
    <style name="Win95.SectionDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:background">@drawable/settings_section_divider</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
