<?xml version="1.0" encoding="utf-8"?>
<!-- A Windows 7 superbar button: icon only. Activated while its window has focus; a pinned
     app with no window swaps its background for taskbar_pin_win7_bg. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskbar_button"
    android:layout_width="50dp"
    android:layout_height="match_parent"
    android:background="@drawable/taskbar_button_win7_bg"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/taskbar_button_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:contentDescription="Dialog icon" />

    <TextView
        android:id="@+id/taskbar_button_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
