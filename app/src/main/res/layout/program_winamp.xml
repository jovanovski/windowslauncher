<?xml version="1.0" encoding="utf-8"?>
<!--
    Winamp is one skinned surface, main window over playlist editor, 275 by 319 skin pixels
    blown up to 358dp wide. On top of it lie the pieces the floating window needs to find by
    id: the title bar to drag by, and the skin's minimize and close buttons. The sizes below
    are those skin rectangles at that scale (1 skin pixel = 1.3dp).
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="358dp"
    android:layout_height="415dp"
    android:clickable="true"
    android:background="@android:color/transparent"
    >

    <rocks.gorjan.gokixp.apps.winamp.WinampSkinView
        android:id="@+id/winamp_skin"
        android:layout_width="358dp"
        android:layout_height="415dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:orientation="horizontal">
        <!-- Left open so a tap reaches the skin's options button -->
        <View
            android:layout_width="20dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:id="@+id/dialog_title_bar"
            android:layout_width="297dp"
            android:layout_height="match_parent"
            android:orientation="horizontal"/>
        <ImageView
            android:id="@+id/dialog_minimize_button"
            android:layout_width="13dp"
            android:layout_height="match_parent"/>
        <View
            android:layout_width="13dp"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/dialog_close_button"
            android:layout_width="13dp"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- Where a menu opened from the skin hangs; moved to the tap before it opens -->
    <View
        android:id="@+id/winamp_menu_anchor"
        android:layout_width="1dp"
        android:layout_height="1dp"/>

</RelativeLayout>
